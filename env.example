# API Configuration
PORT=8080
ENV=development
API_VERSION=v1

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h

# MongoDB Configuration
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=music_api
MONGO_USER=
MONGO_PASSWORD=

# Redis Configuration
REDIS_URI=redis://redis:6379
REDIS_PASSWORD=

# External Services
ITUNES_API_URL=https://itunes.apple.com
CHARTLYRICS_API_URL=http://api.chartlyrics.com/apiv1.asmx